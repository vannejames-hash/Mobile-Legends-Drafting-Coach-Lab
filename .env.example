# ML Draft Lab — environment (copy to .env.local for `vercel dev`, or set in the Vercel dashboard)
#
# Live match rooms in production use Supabase Realtime. Both values below are PUBLIC by design
# (the publishable / anon key); the database is protected by row-level security and host-token RPCs
# (see supabase/schema.sql). NEVER put a service-role / secret key here — it would reach every browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Local server only (node server.js)
# PORT=5173
# HOST=0.0.0.0   # let friends on your network open http://<your-ip>:5173/match/<code>
